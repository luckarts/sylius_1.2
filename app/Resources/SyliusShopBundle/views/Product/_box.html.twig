{% import '@SyliusShop/Common/Macro/money.html.twig' as money %}

{{ sonata_block_render_event('sylius.shop.product.index.before_box', {'product': product}) }}

<a href="{{ path('sylius_shop_product_show', {'slug': product.slug, '_locale': product.translation.locale}) }}" class="fluid card product-card">
    <div class="blurring dimmable image product-card__image-wrapper">
    
        {% include '@SyliusShop/Product/_mainImage.html.twig' with {'product': product} %}

        {% if not product.variants.empty() and product.variants|first.onHand > 0 %}
            <div class="green right corner label">
                <i class="check icon"></i>
            </div>
        {% endif %}
    </div>

    <div class="content product-card__content">
        <div class="header product-card__name sylius-product-name">{{ product.name }}</div>

        {% if product.shortDescription is defined and product.shortDescription %}
            <div class="meta">
                {{ product.shortDescription|slice(0, 80) }}{% if product.shortDescription|length > 80 %}...{% endif %}
            </div>
        {% endif %}

        {% if not product.variants.empty() %}
            <div class="description product-card__price sylius-product-price">
                {{ money.calculatePrice(product|sylius_resolve_variant) }}
            </div>
        {% endif %}
    </div>
</a>

{{ sonata_block_render_event('sylius.shop.product.index.after_box', {'product': product}) }}
